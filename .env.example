# --- Server ---
NODE_ENV=development
PORT=3000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Leave empty when the frontend is served by this server (same origin).
CORS_ORIGIN=
# Public URL of this app (used for PayFast return/notify URLs)
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://diagnosticos:diagnosticos@localhost:5432/diagnosticos

# --- PayFast (South Africa). Leave blank to disable paid-plan checkout. ---
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Development only: lets an admin switch plans without paying. Ignored when NODE_ENV=production.
ALLOW_DEV_PLAN_SWITCH=false

# Set to 1 when running behind a reverse proxy / load balancer (needed for correct rate-limiting IPs).
TRUST_PROXY=

# --- Email (verification, password reset, invoices). Resend: https://resend.com. Without a key, emails are only logged. ---
RESEND_API_KEY=
MAIL_FROM=DiagnosticOS <no-reply@yourdomain.co.za>

# --- SMS / WhatsApp service reminders via Twilio. Without these, SMS is only logged. ---
# TWILIO_FROM can be a number (+27...) or a WhatsApp sender (whatsapp:+27...)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Operations ---
# Key for encrypting stored secrets (customers' PayFast passphrases). Falls back to JWT_SECRET. Back it up: losing it makes saved passphrases unreadable.
SECRETS_KEY=
# Optional error tracking: npm i @sentry/node, then set the DSN.
SENTRY_DSN=
# Hour (UTC) the daily service-reminder run happens. 7 = 09:00 South Africa.
REMINDER_HOUR_UTC=7
# Set false on all but one instance if you run several servers.
RUN_SCHEDULER=true

# --- Self-update ---
# Optional build stamp (e.g. git short SHA) so two deploys of the same version are told apart. Set at deploy time.
# BUILD=
# Optional: a URL returning JSON {"version":"1.2.0","url":"...","notes":"..."} (a GitHub "latest release" API response
# also works). When set, admins are TOLD when a newer release exists — the app never downloads or runs code itself.
UPDATE_CHECK_URL=
